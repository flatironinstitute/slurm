#!/bin/bash -ex
ref=${1:-HEAD}
ver=`git describe $ref`
src=$ver.tar
git archive --prefix=$ver/ --format=tar $ref > $src
. /etc/os-release
plat=${PLATFORM_ID#platform:}
deps=/mnt/sw/nix/state/profiles/$(uname -m)/$ID${VERSION_ID%.[0-9]*}/slurm
export C_INCLUDE_PATH=$deps/include
export LIBRARY_PATH=$deps/lib
export PKG_CONFIG_PATH=$deps/lib/pkgconfig
rpmbuild -ta $src -D "ref $ver" -D "dist .$plat" --with pmix --with nvml --with jwt --with freeipmi
rm $src
